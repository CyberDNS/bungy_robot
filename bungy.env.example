# Copy to bungy.env.local (git-ignored) and adjust for your network/machine:
#   cp bungy.env.example bungy.env.local

# Robot address (hostname or IP). Used by the NUC for connectivity checks,
# remote monitoring, and (future) deploy/update scripts.
ROBOT_IP=robot.example.lan

# Pi only: location of the Dynamixel ros2_control driver workspace
# DYNAMIXEL_WS=$HOME/repos/ros2_control_dynamixel_ax12a

# SSH target used by deploy.sh (an entry from ~/.ssh/config, or user@host).
# Defaults to ROBOT_USER@ROBOT_IP if unset.
# ROBOT_SSH_HOST=bungy
# ROBOT_USER=david
# ROBOT_REPO_DIR=repos/bungy_robot
